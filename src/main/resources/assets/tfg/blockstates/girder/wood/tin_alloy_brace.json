{"multipart": [
    {
        "apply": {"model": "tfg:block/girder/wood/tin_alloy_brace/block_pole"},
        "when": {
            "x": "false",
            "z": "false"
        }
    },
    {
        "apply": {"model": "tfg:block/girder/wood/tin_alloy_brace/block_x"},
        "when": {
            "top": "false",
            "bottom": "false",
            "x": "true",
            "z": "false"
        }
    },
    {
        "apply": {"model": "tfg:block/girder/wood/tin_alloy_brace/block_x_cross"},
        "when": {"OR": [
            {
                "x": "true",
                "z": "true"
            },
            {
                "top": "true",
                "x": "true"
            },
            {
                "bottom": "true",
                "x": "true"
            }
        ]}
    },
    {
        "apply": {"model": "tfg:block/girder/wood/tin_alloy_brace/block_z"},
        "when": {
            "top": "false",
            "bottom": "false",
            "x": "false",
            "z": "true"
        }
    },
    {
        "apply": {"model": "tfg:block/girder/wood/tin_alloy_brace/block_z_cross"},
        "when": {"OR": [
            {
                "x": "true",
                "z": "true"
            },
            {
                "top": "true",
                "z": "true"
            },
            {
                "bottom": "true",
                "z": "true"
            }
        ]}
    },
    {
        "apply": {"model": "tfg:block/girder/wood/tin_alloy_brace/block_top"},
        "when": {"OR": [
            {
                "top": "true",
                "x": "true"
            },
            {
                "top": "true",
                "z": "true"
            }
        ]}
    },
    {
        "apply": {"model": "tfg:block/girder/wood/tin_alloy_brace/block_bottom"},
        "when": {"OR": [
            {
                "bottom": "true",
                "x": "true"
            },
            {
                "bottom": "true",
                "z": "true"
            }
        ]}
    },
    {
        "apply": {"model": "tfg:block/girder/wood/tin_alloy_brace/block_cross"},
        "when": {"OR": [
            {
                "x": "true",
                "z": "true"
            },
            {
                "top": "true",
                "x": "true"
            },
            {
                "bottom": "true",
                "x": "true"
            },
            {
                "top": "true",
                "z": "true"
            },
            {
                "bottom": "true",
                "z": "true"
            }
        ]}
    }
]}
