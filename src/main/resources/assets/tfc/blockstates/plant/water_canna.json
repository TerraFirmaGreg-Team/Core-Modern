{"multipart": [
    {
        "apply": [
            {"model": "tfc:block/plant/canna_base"},
            {
                "y": 90,
                "model": "tfc:block/plant/canna_base"
            },
            {
                "y": 180,
                "model": "tfc:block/plant/canna_base"
            },
            {
                "y": 270,
                "model": "tfc:block/plant/canna_base"
            }
        ],
        "when": {"stage": "0|1|2|3"}
    },
    {
        "apply": [{"model": "tfc:block/plant/canna_stem"}],
        "when": {"stage": "0|1|2|3"}
    },
    {
        "apply": [{"model": "tfc:block/plant/canna_1"}],
        "when": {"stage": "1"}
    },
    {
        "apply": [{"model": "tfc:block/plant/canna_2"}],
        "when": {"stage": "2"}
    },
    {
        "apply": [{"model": "tfc:block/plant/canna_3"}],
        "when": {"stage": "3"}
    }
]}
